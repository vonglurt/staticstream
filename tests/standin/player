#!/bin/sh
# A stand-in for mpv, for the Workspace's tests.
#
# PLAYER is a real program on a real desk and must never be one here: a check
# that opens a video window is a check that cannot run without someone
# watching. This reads what it is given and says how much of it there was, so
# a Service that pipes a capture into a player can be seen to have done it.
if [ "${1:-}" = "-" ] || [ $# -eq 0 ]; then
    n=$(cat | wc -c)
    echo "standin-player: $n bytes on stdin"
else
    echo "standin-player: $*"
fi
